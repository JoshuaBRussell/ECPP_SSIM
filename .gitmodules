[submodule "vendor/raylib"]
	path = vendor/raylib
	url = git@github.com:raysan5/raylib.git
[submodule "vendor/raylib-cpp"]
	path = vendor/raylib-cpp
	url = git@github.com:RobLoach/raylib-cpp.git
[submodule "vendor/imgui"]
	path = vendor/imgui
	url = git@github.com:ocornut/imgui.git
[submodule "vendor/rlImGui"]
	path = vendor/rlImGui
	url = git@github.com:raylib-extras/rlImGui.git
[submodule "vendor/implot"]
	path = vendor/implot
	url = https://github.com/epezent/implot
